{
  "name": "inventrix-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "export-template": "tsx scripts/export-live-template.ts",
    "synth": "scripts/with-live-password.sh cdk synth --quiet",
    "diff": "scripts/with-live-password.sh cdk diff --no-change-set",
    "build:frontend": "pnpm -C ../inventrix-code --filter frontend build",
    "deploy:inventrix": "pnpm build:frontend && scripts/with-live-password.sh cdk deploy inventrix --exclusively"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.276.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "aws-cdk": "^2.1148.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
